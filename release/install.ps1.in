# Installs unii on Windows from arteeh's fork of UniiChat
# (github.com/arteeh/uniichat), in PowerShell (7, or Windows PowerShell 5.1):
#   irm https://github.com/arteeh/uniichat/releases/latest/download/install.ps1 | iex
# (or this release's own: .../releases/download/@VER@/install.ps1)
# The first time, it copies
# ~\.unii\chat to ~\.unii\agents\unii (Unii's memory in the agent team; chat
# stays as it was), with unii's server task stopped while it copies; every
# time, it writes the fixed prompts (prompts/*.md) to
# %LOCALAPPDATA%\unii (edits there are overwritten).
#
# Like install.sh: downloads unii-<ver>-windows-<arch>.zip from this
# release, checks its sha256, and puts its unii.exe at $env:UNII_BIN
# (default %LOCALAPPDATA%\Programs\unii\unii.exe), adding that folder to
# your user PATH. No admin. Your data stays in %USERPROFILE%\.unii
# ($env:UNII_DIR) and %USERPROFILE%\.config\unii, as on Linux.
# `unii update` runs the newest release's copy of this with UNII_BIN set
# to the running unii.exe (and UNII_UPDATER to its pid): a running exe
# can't be overwritten, only renamed, so the one replaced is left as
# unii.exe.old, or .old-<n> (unii removes those exact names at its next
# start). The background services unii made (`unii serve -d`, `unii
# device -d`: the Scheduled Tasks unii-serve and unii-device, their
# description holding "unii-made") that run are restarted on the new exe
# once it is in place, by Task Scheduler (a run asked for while one runs
# stops that one first). While any other unii device or server runs this
# stops, changing nothing: stop it, run this, start it again. A terminal
# chat may stay open (it keeps the old version till it quits).
# It ends setting $LASTEXITCODE (0: installed, 1: not), never `exit`:
# run by `irm | iex`, an exit would close your PowerShell window.
# Nothing to move: no older unii kept a server's data on Windows.

& {
  $ErrorActionPreference = 'Stop'
  $ProgressPreference = 'SilentlyContinue'
  $Ver = '@VER@'
  $Base = "https://github.com/arteeh/uniichat/releases/download/$Ver"
  $Sums = @{ 'x64' = '@SUM_windows-x64@'; 'arm64' = '@SUM_windows-arm64@' }
  $Self = "$Base/install.ps1"
  $tmp = $null
  try {
    if ([Environment]::OSVersion.Platform -ne 'Win32NT') {
      throw "this installer is Windows'; on Linux or macOS: curl -fsSL $Base/install.sh | sh"
    }
    $arch = $env:PROCESSOR_ARCHITEW6432
    if (-not $arch) { $arch = $env:PROCESSOR_ARCHITECTURE }
    switch ($arch) {
      'AMD64' { $arch = 'x64' }
      'ARM64' { $arch = 'arm64' }
      default { throw "$arch is not supported: x64 and arm64 only." }
    }
    $bin = $env:UNII_BIN
    if (-not $bin) { $bin = Join-Path $env:LOCALAPPDATA 'Programs\unii\unii.exe' }
    $dir = $env:UNII_DIR
    if (-not $dir) { $dir = Join-Path $HOME '.unii' }
    $conf = $env:XDG_CONFIG_HOME
    if (-not $conf) { $conf = Join-Path $HOME '.config' }
    $conf = Join-Path $conf 'unii'

    # a unii device or server running (a unii.exe, or one by $bin's name
    # or path) that no service of unii's runs: it would keep the old
    # version, and its data must not change under it. One whose command
    # line Windows doesn't show (CIM failing, another user's, an elevated
    # one) counts as running; the `unii update` that runs this
    # (UNII_UPDATER) doesn't, nor a service's supervisor (`--service`)
    # and what it started, which the restart below ends. A service that
    # runs elevated (`sudo unii device -d`) shows no command line to a
    # shell that isn't: its supervisor and unii are known by the pids it
    # wrote (logs\<part>.pid), while its task runs
    $leaf = Split-Path -Leaf $bin
    $names = @('unii.exe', $leaf)
    $procs = $null
    $mine = ''
    try {
      $all = @(Get-CimInstance Win32_Process -ErrorAction Stop)
      $up = @{}
      foreach ($p in $all) { $up[[string]$p.ProcessId] = [string]$p.ParentProcessId }
      $sups = @($all | Where-Object { ($names -icontains $_.Name) -and ([string]$_.CommandLine -match '\s"?--service"?(\s|$)') } | ForEach-Object { [string]$_.ProcessId })
      foreach ($part in 'serve', 'device') {
        $task = $null
        try { $task = Get-ScheduledTask -TaskName "unii-$part" -TaskPath '\' -ErrorAction Stop } catch {}
        if ($task -and ([string]$task.Description -match 'unii-made') -and ([string]$task.State -eq 'Running')) {
          try { $sups += @((Get-Content -LiteralPath (Join-Path $dir "logs\$part.pid") -ErrorAction Stop) -split '\s+' | Where-Object { $_ -match '^[0-9]+$' }) } catch {}
        }
      }
      $served = { param($id) for ($k = 0; $k -lt 8 -and $id; $k++) { if ($sups -contains $id) { return $true }; $id = $up[$id] }; return $false }
      # the supervisor this runs under, if any (`unii update` from a service's shell): its command line
      $id = [string]$PID
      for ($k = 0; $k -lt 16 -and $id; $k++) { if ($sups -contains $id) { $mine = [string]($all | Where-Object { [string]$_.ProcessId -eq $id } | Select-Object -First 1).CommandLine; break }; $id = $up[$id] }
      $procs = @($all | Where-Object { ($names -icontains $_.Name) -or ($_.ExecutablePath -and $_.ExecutablePath -ieq $bin) } | Where-Object { -not (& $served ([string]$_.ProcessId)) } | ForEach-Object { [pscustomobject]@{ Id = [string]$_.ProcessId; Line = [string]$_.CommandLine } })
    } catch {
      $stems = @($names) + @($names | ForEach-Object { [IO.Path]::GetFileNameWithoutExtension($_) })
      $procs = @(Get-Process -ErrorAction SilentlyContinue | Where-Object { $stems -icontains $_.ProcessName } | ForEach-Object { [pscustomobject]@{ Id = [string]$_.Id; Line = '' } })
    }
    $procs = @($procs | Where-Object { $_.Id -ne [string]$env:UNII_UPDATER })
    $busy = @($procs | Where-Object { $_.Line -match '\s"?(device|serve)"?(\s|$)' })
    $blind = @($procs | Where-Object { $_.Line -eq '' })
    $again = "Stop it (taskkill /T /F /PID <pid>; if a Scheduled Task you made runs it, first Disable-ScheduledTask and Stop-ScheduledTask it), run this again (irm $Self | iex), then start it again. Run as unii device -d (or unii serve -d) instead, it's restarted by updates."
    if ($busy.Count -gt 0) {
      throw ("a unii device or server runs (pid " + (($busy | ForEach-Object { $_.Id }) -join ', ') + "). Nothing changed, and unii $Ver was not installed. $again")
    }
    if ($blind.Count -gt 0) {
      throw ("unii runs (pid " + (($blind | ForEach-Object { $_.Id }) -join ', ') + "), and Windows won't say whether as a device or server. Nothing changed, and unii $Ver was not installed. Quit every unii (a terminal chat too), or: $again")
    }

    try { [Net.ServicePointManager]::SecurityProtocol = [Net.ServicePointManager]::SecurityProtocol -bor [Net.SecurityProtocolType]::Tls12 } catch {}
    $name = "unii-$Ver-windows-$arch.zip"
    $tmp = Join-Path ([IO.Path]::GetTempPath()) ('unii-' + [guid]::NewGuid())
    New-Item -ItemType Directory -Path $tmp | Out-Null
    $zip = Join-Path $tmp $name
    Write-Host "downloading $Base/$name"
    try {
      Invoke-WebRequest -UseBasicParsing -Uri "$Base/$name" -OutFile $zip
    } catch {
      throw "the download failed: $name ($($_.Exception.Message))"
    }
    if ((Get-FileHash -Algorithm SHA256 -LiteralPath $zip).Hash.ToLower() -ne $Sums[$arch]) {
      throw "$name does not match its sha256; not installed"
    }
    Expand-Archive -LiteralPath $zip -DestinationPath (Join-Path $tmp 'x')
    $exe = Join-Path $tmp 'x\unii.exe'
    if (-not (Test-Path -LiteralPath $exe)) { throw "$name holds no unii.exe; not installed" }

    # the agent team's own: Unii's memory, copied once from chat (with the server
    # task stopped meanwhile, started again below), and the fixed prompts,
    # written every time
    $halted = @()
    $chat = Join-Path $dir 'chat'
    $unii = Join-Path $dir 'agents\unii'
    if ((Test-Path -LiteralPath $chat) -and -not (Test-Path -LiteralPath $unii)) {
      try { $halted = @(Get-ScheduledTask -TaskName 'unii-serve' -TaskPath '\' -ErrorAction SilentlyContinue | Where-Object { ([string]$_.Description -match 'unii-made') -and ([string]$_.State -eq 'Running') }) } catch {}
      foreach ($t in $halted) { Stop-ScheduledTask -TaskName $t.TaskName -TaskPath '\' }
      # no server may write to chat while it is copied: the one whose pid
      # server.pid holds must be gone (waited for up to 10 s), else nothing
      # is copied and the stopped task starts again
      $live = { $p = 0; try { $p = [int]((Get-Content -LiteralPath (Join-Path $dir 'server.pid') -ErrorAction Stop) | Select-Object -First 1) } catch {}; ($p -gt 0) -and ($null -ne (Get-Process -Id $p -ErrorAction SilentlyContinue)) }
      for ($k = 0; $k -lt 20 -and (& $live); $k++) { Start-Sleep -Milliseconds 500 }
      if (& $live) {
        foreach ($t in $halted) { try { Start-ScheduledTask -TaskName $t.TaskName -TaskPath '\' } catch {} }
        throw "the agent team copies your chat to $unii with no unii server running, but one still runs on it (its pid is in $dir\server.pid). Nothing changed, and unii $Ver was not installed: stop it, run this again, then start it."
      }
      $copy = Join-Path $dir 'agents\.unii-copy'
      New-Item -ItemType Directory -Force -Path (Join-Path $dir 'agents') | Out-Null
      Remove-Item -LiteralPath $copy -Recurse -Force -ErrorAction SilentlyContinue
      Copy-Item -LiteralPath $chat -Destination $copy -Recurse
      Move-Item -LiteralPath $copy -Destination $unii
      Write-Host "  Copied $chat to $unii, Unii's memory in the agent team ($chat stays as it was)."
    }
    $share = Join-Path $env:LOCALAPPDATA 'unii'
    New-Item -ItemType Directory -Force -Path $share | Out-Null
@PROMPT_FILES_PS1@

    # beside $bin first (temp may be another drive), then swapped in: the
    # old exe renamed (it may run: this may be its `unii update`), the old
    # ones that no longer run removed
    $folder = Split-Path -Parent $bin
    New-Item -ItemType Directory -Force -Path $folder | Out-Null
    $new = "$bin.new"
    Copy-Item -LiteralPath $exe -Destination $new -Force
    $old = $null
    if (Test-Path -LiteralPath $bin) {
      $olds = '^' + [regex]::Escape($leaf) + '\.old(-[0-9]+)?$'
      Get-ChildItem -LiteralPath $folder -File | Where-Object { $_.Name -match $olds } | ForEach-Object { Remove-Item -LiteralPath $_.FullName -Force -ErrorAction SilentlyContinue }
      $old = "$bin.old"
      for ($k = 2; Test-Path -LiteralPath $old; $k++) { $old = "$bin.old-$k" }
      Move-Item -LiteralPath $bin -Destination $old
    }
    try {
      Move-Item -LiteralPath $new -Destination $bin
    } catch {
      if ($old) { Move-Item -LiteralPath $old -Destination $bin }
      Remove-Item -LiteralPath $new -Force -ErrorAction SilentlyContinue
      throw "could not write $bin ($($_.Exception.Message))"
    }
    # the version check's cache, from before unii 18 (it checks no more)
    Remove-Item -LiteralPath (Join-Path $conf 'check.json'), (Join-Path $dir 'check.json') -Force -ErrorAction SilentlyContinue

    Write-Host ""
    Write-Host "  unii $Ver (arteeh fork) is installed at $bin."
    Write-Host "  Server: unii serve -d   Device: unii device -d <url>"
    # the user PATH, as written (REG_EXPAND_SZ, %VARS% kept), then a
    # setting's change told to Windows, so new terminals find unii: unless
    # the saved user or machine Path has the folder (this shell's own
    # $env:Path may have it only for now); this shell's gets it too
    $key = [Microsoft.Win32.Registry]::CurrentUser.OpenSubKey('Environment', $true)
    $path = [string]$key.GetValue('Path', '', 'DoNotExpandEnvironmentNames')
    $have = @($path -split ';' | Where-Object { $_ -ne '' })
    $machine = @(([string][Environment]::GetEnvironmentVariable('Path', 'Machine')) -split ';' | Where-Object { $_ -ne '' })
    $is = { param($p) [Environment]::ExpandEnvironmentVariables($p).TrimEnd('\') -ieq $folder.TrimEnd('\') }
    $there = @($have + $machine | Where-Object { & $is $_ })
    if ($there.Count -eq 0) {
      $key.SetValue('Path', (($have + $folder) -join ';'), [Microsoft.Win32.RegistryValueKind]::ExpandString)
      [Environment]::SetEnvironmentVariable('UNII_PATH_SET', '1', 'User')
      [Environment]::SetEnvironmentVariable('UNII_PATH_SET', [NullString]::Value, 'User')
      Write-Host "  Added $folder to your PATH: open a new terminal to run unii by name."
    }
    $key.Close()
    if (@($env:Path -split ';' | Where-Object { $_ -ne '' -and (& $is $_) }).Count -eq 0) {
      $env:Path = "$env:Path;$folder"
    }
    $global:LASTEXITCODE = 0
    # last: unii's services that run, restarted on the new exe by Task
    # Scheduler (run from such a service's shell, `unii update`, this ends
    # with it: so that one goes last, else the device, whose shells run
    # such updates)
    $made = @()
    try { $made = @(Get-ScheduledTask -TaskName 'unii-serve', 'unii-device' -TaskPath '\' -ErrorAction SilentlyContinue | Where-Object { ([string]$_.Description -match 'unii-made') -and ([string]$_.State -eq 'Running') }) } catch {}
    $made = @($made | Sort-Object { $mine -match ('\s"?' + $_.TaskName.Substring(5) + '"?\s') }, { $_.TaskName -eq 'unii-device' })
    foreach ($t in $halted) {
      Write-Host ("  Starting " + $t.TaskName + " again, on unii $Ver.")
      try { Start-ScheduledTask -TaskName $t.TaskName -TaskPath '\' } catch { Write-Host ("  Could not start " + $t.TaskName + ": run unii serve -d to.") }
    }
    foreach ($t in $made) {
      Write-Host ("  Restarting " + $t.TaskName + " on unii $Ver.")
      try { Start-ScheduledTask -TaskName $t.TaskName -TaskPath '\' } catch { Write-Host ("  Could not restart " + $t.TaskName + ": run " + $(if ([string]$t.Principal.RunLevel -eq 'Highest') { 'sudo ' } else { '' }) + "unii " + $t.TaskName.Substring(5) + " -d to.") }
    }
  } catch {
    Write-Host ("unii: " + $_.Exception.Message) -ForegroundColor Red
    $global:LASTEXITCODE = 1
  } finally {
    if ($tmp) { Remove-Item -LiteralPath $tmp -Recurse -Force -ErrorAction SilentlyContinue }
  }
}
