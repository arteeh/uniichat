# Installs ki on Windows (github.com/arteeh/ki), in PowerShell (7, or
# Windows PowerShell 5.1):
#   irm https://github.com/arteeh/ki/releases/latest/download/install.ps1 | iex
# (or this release's own: .../releases/download/@VER@/install.ps1, the only
# line for a release candidate, N.rcM: its `ki update` refuses)
#
# Like install.sh: downloads ki-<ver>-windows-<arch>.zip from this
# release, checks its sha256, and puts its ki.exe at $env:KI_BIN (default
# %LOCALAPPDATA%\Programs\ki\ki.exe), adding that folder to your user
# PATH. No admin. Your data stays in %USERPROFILE%\.ki ($env:KI_DIR) and
# %USERPROFILE%\.config\ki, as on Linux. Every time, it writes the fixed
# prompts (prompts/*.md) to %LOCALAPPDATA%\ki (edits there are
# overwritten). `ki update` runs the newest release's copy of this with
# KI_BIN set to the running ki.exe (and KI_UPDATER to its pid): a running
# exe can't be overwritten, only renamed, so the one replaced is left as
# ki.exe.old, or .old-<n> (ki removes those exact names at its next
# start). The background services ki made (`ki serve -d`, `ki device -d`:
# the Scheduled Tasks ki-serve and ki-device, their description holding
# "ki-made") that run are restarted on the new exe once it is in place,
# by Task Scheduler (a run asked for while one runs stops that one
# first). While any other ki device or server runs this stops, changing
# nothing: stop it, run this, start it again. A terminal chat may stay
# open (it keeps the old version till it quits).
#
# ki was called unii before (UniiChat). Where this finds unii, it moves
# everything over, once: unii's tasks (unii-serve, unii-device) are
# stopped and become ki's (ki-serve, ki-device, same settings), %USERPROFILE%\.unii
# moves to .ki and .config\unii to .config\ki (unless those exist
# already: then it changes nothing and says so), the data in it is given
# ki's names (by the new ki.exe, run as bun: BUN_BE_BUN=1), and unii's
# exe and its PATH entry go (once the `unii update` that ran this has
# quit). `unii update` runs this from inside a unii task, whose stop would
# end it: then this starts itself again outside it and says where its
# output goes. UNII_* settings ki still has are KI_* now, and the rest
# are gone: this warns about each one, and the tasks keep the KI_* ones.
# A unii task that runs as administrator (`sudo unii device -d`) is moved
# only by a run as administrator: any other run stops, changing nothing.
#
# The first time, it copies ~\.ki\chat to ~\.ki\agents\unii (the main
# agent's memory in the agent team; chat stays as it was), with the server
# stopped while it copies. Every time, data from an older ki is brought to
# this version's layout (upgrade.js, by the new ki.exe as bun: each step
# once, with ki's server stopped meanwhile, and started again after).
# It ends setting $LASTEXITCODE (0: installed, 1: not), never `exit`:
# run by `irm | iex`, an exit would close your PowerShell window.

& {
  $ErrorActionPreference = 'Stop'
  $ProgressPreference = 'SilentlyContinue'
  $Ver = '@VER@'
  $Base = "https://github.com/arteeh/ki/releases/download/$Ver"
  $Sums = @{ 'x64' = '@SUM_windows-x64@'; 'arm64' = '@SUM_windows-arm64@' }
  $Self = "$Base/install.ps1"
  $tmp = $null
  # the tasks this stopped, which a failure starts again (as install.sh does)
  $stopped = @()
  try {
    if ([Environment]::OSVersion.Platform -ne 'Win32NT') {
      throw "this installer is Windows'; on Linux or macOS: curl -fsSL $Base/install.sh | sh"
    }
    $arch = $env:PROCESSOR_ARCHITEW6432
    if (-not $arch) { $arch = $env:PROCESSOR_ARCHITECTURE }
    switch ($arch) {
      'AMD64' { $arch = 'x64' }
      'ARM64' { $arch = 'arm64' }
      default { throw "$arch is not supported: x64 and arm64 only." }
    }
    $bin = $env:KI_BIN
    if (-not $bin) { $bin = Join-Path $env:LOCALAPPDATA 'Programs\ki\ki.exe' }
    $cfg = $env:XDG_CONFIG_HOME
    if (-not $cfg) { $cfg = Join-Path $HOME '.config' }
    $conf = Join-Path $cfg 'ki'

    # unii, as ki was called before: its data, sign-ins, tasks and exe
    $oldBin = $env:UNII_BIN
    if (-not $oldBin) { $oldBin = Join-Path $env:LOCALAPPDATA 'Programs\unii\unii.exe' }
    # the KI_* settings ki reads, and those unii set for its own processes
    $reads = @('URL', 'DIR', 'PROFILES', 'MCP', 'VENDORS', 'MODELS', 'PICK', 'COMPACTOR', 'COMPACTOR_CONTEXT', 'HOPS', 'THINKING', 'AFTER', 'CHATGPT', 'CHATGPT_ISSUER', 'CHATGPT_URL', 'CLAUDE', 'CLAUDE_SUB', 'MEDIA_MB')
    $own = @('BIN', 'UPDATER', 'RUN', 'AGENT', 'SERVICE', 'SUPERVISOR')
    $task = { param($n) try { Get-ScheduledTask -TaskName $n -TaskPath '\' -ErrorAction Stop } catch { $null } }
    $olds = @('serve', 'device' | ForEach-Object { & $task "unii-$_" } | Where-Object { $_ -and ([string]$_.Description -match 'unii-made') })
    # a command line split as Windows splits it (CommandLineToArgvW: a
    # backslash run before a quote halved, an odd one escaping it), and
    # put back (as Service.ts's winq)
    $argv = {
      param($s)
      $out = New-Object System.Collections.Generic.List[string]
      $i = 0; $n = $s.Length
      while ($i -lt $n) {
        while ($i -lt $n -and [char]::IsWhiteSpace($s[$i])) { $i++ }
        if ($i -ge $n) { break }
        $a = New-Object Text.StringBuilder; $q = $false
        while ($i -lt $n -and ($q -or -not [char]::IsWhiteSpace($s[$i]))) {
          $b = 0
          while ($i -lt $n -and $s[$i] -eq [char]'\') { $b++; $i++ }
          if ($i -lt $n -and $s[$i] -eq [char]'"') {
            [void]$a.Append([string]::new([char]'\', [int][math]::Floor($b / 2)))
            if ($b % 2 -eq 1) { [void]$a.Append('"') } else { $q = -not $q }
            $i++
          } elseif ($b -gt 0) {
            [void]$a.Append([string]::new([char]'\', $b))
          } else {
            [void]$a.Append($s[$i]); $i++
          }
        }
        $out.Add($a.ToString())
      }
      $out.ToArray()
    }
    $winq = { param($a) if ($a -ne '' -and $a -notmatch '[\s"]') { return $a }; '"' + [regex]::Replace([regex]::Replace($a, '(\\*)"', '$1$1\"'), '(\\+)$', '$1$1') + '"' }
    $samedir = { param($a, $b) ([string]$a).TrimEnd('\', '/') -ieq ([string]$b).TrimEnd('\', '/') }
    # a download, tried 3 times: a dropped connection, a body cut short of
    # its Content-Length (Invoke-WebRequest keeps what came) and one $bad
    # finds fault with (its why, else nothing) are tried again
    $fetch = {
      param($w, $bad)
      for ($k = 1; ; $k++) {
        try {
          $o = @{} + $w
          if ($o.OutFile) { $o.PassThru = $true }
          $r = Invoke-WebRequest -UseBasicParsing @o
          $want = [string]@($r.Headers['Content-Length'])[0]
          $got = $(if ($o.OutFile) { (Get-Item -LiteralPath $o.OutFile).Length } else { $r.RawContentLength })
          if ($want -match '^[0-9]+$' -and [long]$want -ne [long]$got) { throw "it was cut short: $got of $want bytes came" }
          $why = $(if ($bad) { & $bad $r })
          if ($why) { throw $why }
          return $r
        } catch { if ($k -ge 3) { throw }; Start-Sleep -Seconds 2 }
      }
    }
    # the data folder unii's tasks were given (--env=UNII_DIR=), else
    # unii's default: where unii's data is, so ki keeps it there (as when
    # UNII_DIR is set here)
    $uniiDir = $env:UNII_DIR
    $udir = $null; $uwho = $null
    foreach ($t in $olds) {
      $v = Join-Path $HOME '.unii'
      foreach ($a in @(& $argv ([string]@($t.Actions)[0].Arguments))) { if ($a -like '--env=UNII_DIR=*') { $v = $a.Substring('--env=UNII_DIR='.Length) } }
      if ($udir -and -not (& $samedir $udir $v)) {
        throw ("unii's tasks keep their data in two folders, $udir ($uwho) and $v (" + $t.TaskName + "), and which one ki should use isn't clear, so nothing changed and ki $Ver was not installed. Remove the task whose folder you don't need (unii " + $uwho.Substring(5) + " stop, or unii " + $t.TaskName.Substring(5) + " stop), then run this again.")
      }
      $udir = $v; $uwho = $t.TaskName
    }
    if ($udir) {
      if ($uniiDir -and -not (& $samedir $uniiDir $udir)) {
        throw "unii's task $uwho keeps its data in $udir, but UNII_DIR here says $uniiDir, and which one ki should use isn't clear, so nothing changed and ki $Ver was not installed. Run this again without UNII_DIR (or with it set to $udir)."
      }
      if (-not (& $samedir $udir (Join-Path $HOME '.unii'))) { $uniiDir = $udir }
    }
    $dir = $env:KI_DIR
    if (-not $dir) { $dir = $uniiDir }
    if (-not $dir) { $dir = Join-Path $HOME '.ki' }
    $odir = $uniiDir
    if (-not $odir) { $odir = Join-Path $HOME '.unii' }
    if (& $samedir $odir $dir) { $odir = $null }
    $oconf = Join-Path $cfg 'unii'
    $moving = $odir -and (Test-Path -LiteralPath $odir -PathType Container)
    if ($moving -and (Test-Path -LiteralPath $dir)) {
      throw "both $odir (unii's, as ki was called before) and $dir are here, and which one to keep isn't clear, so nothing changed and ki $Ver was not installed. Move the one you don't need aside, then run this again."
    }
    if ((Test-Path -LiteralPath $oconf) -and (Test-Path -LiteralPath $conf)) {
      Write-Host "  $oconf was not moved: $conf exists already. Move $oconf aside if you don't need it."
    }
    foreach ($v in @(Get-ChildItem env: | Where-Object { $_.Name -like 'UNII_*' -and $own -notcontains $_.Name.Substring(5) })) {
      if ($reads -contains $v.Name.Substring(5)) {
        Write-Host ("  " + $v.Name + " is set: ki doesn't read it any more; it reads KI_" + $v.Name.Substring(5).ToUpper() + ".")
      } else {
        Write-Host ("  " + $v.Name + " is set: it isn't used any more, and can be removed.")
      }
    }
    $cur = $dir
    if ($moving) { $cur = $odir }
    if ((Test-Path -LiteralPath (Join-Path $cur 'unii.db')) -and (Test-Path -LiteralPath (Join-Path $cur 'ki.db'))) {
      throw "$cur has both unii.db (unii's sign-ins, agents and settings) and ki.db (made by a ki that started on it before it was moved over), and which one to keep isn't clear, so nothing changed and ki $Ver was not installed. Move ki.db (and ki.db-wal, ki.db-shm) aside to keep unii's, or unii.db (and its -wal, -shm) to keep ki's, then run this again."
    }
    # (a device alone has no data folder, and no task if it runs in a
    # terminal: its sign-in, in unii's config folder, and unii's exe are
    # enough)
    $renaming = $moving -or ($olds.Count -gt 0) -or (Test-Path -LiteralPath (Join-Path $cur 'unii.db')) -or (Test-Path -LiteralPath (Join-Path $cur '.renaming')) -or
      ((Test-Path -LiteralPath $oconf) -and -not (Test-Path -LiteralPath $conf)) -or ((Test-Path -LiteralPath $oldBin -PathType Leaf) -and -not ($oldBin -ieq $bin))
    # unii's tasks that run as administrator (`sudo unii device -d`) can
    # only be moved by a shell that runs as one too
    $high = @($olds | Where-Object { [string]$_.Principal.RunLevel -eq 'Highest' })
    $admin = ([Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)
    if ($high.Count -gt 0 -and -not $admin) {
      throw ("unii's task " + (($high | ForEach-Object { $_.TaskName }) -join ', ') + " runs as administrator, and this shell doesn't, so it can't be moved to ki. Nothing changed, and ki $Ver was not installed: run this again as administrator (or with sudo).")
    }

    # a ki (or unii) device or server running (a ki.exe or unii.exe, or one
    # by $bin's name or path) that no service runs: it would keep the old
    # version, and its data must not change under it. One whose command
    # line Windows doesn't show (CIM failing, another user's, an elevated
    # one) counts as running; the `ki update` (or `unii update`) that runs
    # this doesn't, nor a service's supervisor (`--service`) and what it
    # started, which the restart below ends. A service that runs elevated
    # (`sudo ki device -d`) shows no command line to a shell that isn't:
    # its supervisor and ki are known by the pids it wrote
    # (logs\<part>.pid), while its task runs
    $leaf = Split-Path -Leaf $bin
    $names = @('ki.exe', 'unii.exe', $leaf)
    $procs = $null
    $mine = ''
    try {
      $all = @(Get-CimInstance Win32_Process -ErrorAction Stop)
      $up = @{}
      foreach ($p in $all) { $up[[string]$p.ProcessId] = [string]$p.ParentProcessId }
      $sups = @($all | Where-Object { ($names -icontains $_.Name) -and ([string]$_.CommandLine -match '\s"?--service"?(\s|$)') } | ForEach-Object { [string]$_.ProcessId })
      foreach ($pair in @(@('ki', $dir, 'ki-made'), @('unii', $cur, 'unii-made'))) {
        foreach ($part in 'serve', 'device') {
          $t = & $task ($pair[0] + "-$part")
          if ($t -and ([string]$t.Description -match $pair[2]) -and ([string]$t.State -eq 'Running')) {
            try { $sups += @((Get-Content -LiteralPath (Join-Path $pair[1] "logs\$part.pid") -ErrorAction Stop) -split '\s+' | Where-Object { $_ -match '^[0-9]+$' }) } catch {}
          }
        }
      }
      $served = { param($id) for ($k = 0; $k -lt 8 -and $id; $k++) { if ($sups -contains $id) { return $true }; $id = $up[$id] }; return $false }
      # the supervisor this runs under, if any (`ki update` from a service's shell): its command line
      $id = [string]$PID
      for ($k = 0; $k -lt 16 -and $id; $k++) { if ($sups -contains $id) { $mine = [string]($all | Where-Object { [string]$_.ProcessId -eq $id } | Select-Object -First 1).CommandLine; break }; $id = $up[$id] }
      $procs = @($all | Where-Object { ($names -icontains $_.Name) -or ($_.ExecutablePath -and $_.ExecutablePath -ieq $bin) } | Where-Object { -not (& $served ([string]$_.ProcessId)) } | ForEach-Object { [pscustomobject]@{ Id = [string]$_.ProcessId; Line = [string]$_.CommandLine } })
    } catch {
      $stems = @($names) + @($names | ForEach-Object { [IO.Path]::GetFileNameWithoutExtension($_) })
      $procs = @(Get-Process -ErrorAction SilentlyContinue | Where-Object { $stems -icontains $_.ProcessName } | ForEach-Object { [pscustomobject]@{ Id = [string]$_.Id; Line = '' } })
    }
    $procs = @($procs | Where-Object { $_.Id -ne [string]$env:KI_UPDATER -and $_.Id -ne [string]$env:UNII_UPDATER })
    $busy = @($procs | Where-Object { $_.Line -match '\s"?(device|serve)"?(\s|$)' })
    $blind = @($procs | Where-Object { $_.Line -eq '' })
    $again = "Stop it (taskkill /T /F /PID <pid>; if a Scheduled Task you made runs it, first Disable-ScheduledTask and Stop-ScheduledTask it), run this again (irm $Self | iex), then start it again. Run as ki device -d (or ki serve -d) instead, it's restarted by updates."
    if ($busy.Count -gt 0) {
      throw ("a device or server runs (pid " + (($busy | ForEach-Object { $_.Id }) -join ', ') + "). Nothing changed, and ki $Ver was not installed. $again")
    }
    if ($blind.Count -gt 0) {
      throw ("ki (or unii) runs (pid " + (($blind | ForEach-Object { $_.Id }) -join ', ') + "), and Windows won't say whether as a device or server. Nothing changed, and ki $Ver was not installed. Quit every one (a terminal chat too), or: $again")
    }

    # `unii update` from a unii task's shell: that task stops below, which
    # would end this, so it runs again outside it (started by WMI, so not
    # in the task's process tree), by itself
    if ($renaming -and $mine -and ($mine -match '\\unii\.exe"?\s') -and -not $env:KI_INSTALL_OUTSIDE) {
      $stage = Join-Path ([IO.Path]::GetTempPath()) ('ki-install-' + [guid]::NewGuid())
      New-Item -ItemType Directory -Path $stage | Out-Null
      $file = Join-Path $stage 'install.ps1'
      $log = Join-Path $stage 'install.log'
      $set = "`$env:KI_INSTALL_OUTSIDE = '1'`r`n"
      foreach ($v in 'UNII_BIN', 'UNII_DIR', 'UNII_UPDATER', 'KI_BIN', 'KI_DIR', 'XDG_CONFIG_HOME') {
        $x = [Environment]::GetEnvironmentVariable($v)
        if ($x) { $set += "`$env:$v = '" + $x.Replace("'", "''") + "'`r`n" }
      }
      $text = { param($r) $c = $r.Content; if ($c -is [byte[]]) { $c = [Text.Encoding]::UTF8.GetString($c) }; $c }
      $cut = { param($r) if (-not ([string](& $text $r)).TrimEnd().EndsWith('}')) { 'it ends before the installer does' } }
      try { $body = & $text (& $fetch @{ Uri = $Self } $cut) } catch { throw "could not download $Self again to run it outside unii's task ($($_.Exception.Message)). Nothing changed: run this installer in a terminal." }
      [IO.File]::WriteAllText($file, $set + $body)
      $line = 'cmd.exe /c powershell.exe -NoProfile -ExecutionPolicy Bypass -File "' + $file + '" > "' + $log + '" 2>&1'
      $made = Invoke-CimMethod -ClassName Win32_Process -MethodName Create -Arguments @{ CommandLine = $line }
      if ($made.ReturnValue -ne 0) { throw "could not start the installer outside unii's task (WMI: $($made.ReturnValue)). Nothing changed: run this installer in a terminal." }
      Write-Host "  unii becomes ki: that stops unii's task, which this runs in, so the install goes on by itself outside it. Its output: $log"
      $global:LASTEXITCODE = 0
      return
    }

    try { [Net.ServicePointManager]::SecurityProtocol = [Net.ServicePointManager]::SecurityProtocol -bor [Net.SecurityProtocolType]::Tls12 } catch {}
    $name = "ki-$Ver-windows-$arch.zip"
    $tmp = Join-Path ([IO.Path]::GetTempPath()) ('ki-' + [guid]::NewGuid())
    New-Item -ItemType Directory -Path $tmp | Out-Null
    $zip = Join-Path $tmp $name
    Write-Host "downloading $Base/$name"
    $sha = { if ((Get-FileHash -Algorithm SHA256 -LiteralPath $zip).Hash.ToLower() -ne $Sums[$arch]) { 'it does not match its sha256' } }
    try {
      & $fetch @{ Uri = "$Base/$name"; OutFile = $zip } $sha | Out-Null
    } catch {
      throw "the download failed: $name ($($_.Exception.Message)); not installed"
    }
    Expand-Archive -LiteralPath $zip -DestinationPath (Join-Path $tmp 'x')
    $exe = Join-Path $tmp 'x\ki.exe'
    if (-not (Test-Path -LiteralPath $exe)) { throw "$name holds no ki.exe; not installed" }
    $rename = Join-Path $tmp 'rename.js'
    [IO.File]::WriteAllText($rename, [Text.Encoding]::UTF8.GetString([Convert]::FromBase64String('@RENAME_JS_B64@')))
    $upgrade = Join-Path $tmp 'upgrade.js'
    [IO.File]::WriteAllText($upgrade, [Text.Encoding]::UTF8.GetString([Convert]::FromBase64String('@UPGRADE_JS_B64@')))
    $named = {
      $env:BUN_BE_BUN = '1'
      try { & $exe $rename $dir $conf } finally { Remove-Item Env:\BUN_BE_BUN -ErrorAction SilentlyContinue }
      if ($LASTEXITCODE -ne 0) { throw "giving your data in $dir ki's names stopped halfway (see above): run this again. ki $Ver was not installed." }
    }

    # no server may run on the data while it moves or is copied: the tasks
    # that run stop meanwhile (unii's for good, ki's to start again below)
    $halted = @()
    $chat = Join-Path $cur 'chat'
    $copying = (Test-Path -LiteralPath $chat) -and -not (Test-Path -LiteralPath (Join-Path $cur 'agents\unii'))
    $upgrading = $false
    if (Test-Path -LiteralPath $cur -PathType Container) {
      $env:BUN_BE_BUN = '1'
      try { & $exe $upgrade check $cur } finally { Remove-Item Env:\BUN_BE_BUN -ErrorAction SilentlyContinue }
      if ($LASTEXITCODE -eq 3) { $upgrading = $true } elseif ($LASTEXITCODE -ne 0) { throw "nothing changed; ki $Ver was not installed." }
    }
    if ($renaming -or $copying -or $upgrading) {
      # a layout step alone stops the server only: a device keeps no data there
      $which = $(if ($renaming -or $copying) { @('serve', 'device') } else { @('serve') })
      if (-not ($renaming -or $copying) -and ($mine -match '\s"?serve"?(\s|$)')) {
        throw "your data must move with no ki server running, and this runs in a shell of ki-serve, which stopping would end. Nothing changed, and ki $Ver was not installed: run this installer in a terminal."
      }
      $halted = @($which | ForEach-Object { & $task "ki-$_" } | Where-Object { $_ -and ([string]$_.Description -match 'ki-made') -and ([string]$_.State -eq 'Running') })
      # the tasks stopped, started again: "Nothing changed", else which
      # stay stopped and how to start them
      $restart = {
        param($ts)
        $left = @(foreach ($t in $ts) { try { Start-ScheduledTask -TaskName $t.TaskName -TaskPath '\' -ErrorAction Stop } catch { [pscustomobject]@{ Name = $t.TaskName; Why = $_.Exception.Message; High = ([string]$t.Principal.RunLevel -eq 'Highest') } } })
        if ($left.Count -eq 0) { return 'Nothing changed' }
        'Nothing changed but this: ' + (($left | ForEach-Object { $_.Name + ' (' + $_.Why + ')' }) -join ', ') + ' could not start again, so ' + $(if ($left.Count -eq 1) { 'it stays' } else { 'they stay' }) + ' stopped: start ' + $(if ($left.Count -eq 1) { 'it' } else { 'them' }) + ' with ' + (($left | ForEach-Object { 'schtasks /run /tn ' + $_.Name + $(if ($_.High) { ' (as administrator)' } else { '' }) }) -join ', ')
      }
      $done = @()
      foreach ($t in @($olds | Where-Object { [string]$_.State -eq 'Running' }) + $halted) {
        try {
          Stop-ScheduledTask -TaskName $t.TaskName -TaskPath '\' -ErrorAction Stop
          $done += $t
        } catch {
          $why = $_.Exception.Message
          throw ("could not stop the task " + $t.TaskName + " ($why). " + (& $restart $done) + ", and ki $Ver was not installed: run this again" + $(if ([string]$t.Principal.RunLevel -eq 'Highest') { ' as administrator' } else { '' }) + ".")
        }
      }
      # the one whose pid server.pid holds must be gone (waited for up to
      # 10 s), else nothing changes and the stopped tasks start again
      $live = { $p = 0; try { $p = [int]((Get-Content -LiteralPath (Join-Path $cur 'server.pid') -ErrorAction Stop) | Select-Object -First 1) } catch {}; ($p -gt 0) -and ($null -ne (Get-Process -Id $p -ErrorAction SilentlyContinue)) }
      for ($k = 0; $k -lt 20 -and (& $live); $k++) { Start-Sleep -Milliseconds 500 }
      if (& $live) {
        throw ("your data must move with no server running, but one still runs on it (its pid is in $cur\server.pid). " + (& $restart (@($olds | Where-Object { [string]$_.State -eq 'Running' }) + $halted)) + ", and ki $Ver was not installed: stop it, run this again, then start it.")
      }
      $stopped = @($done)
    }

    # unii's own become ki's: the data and sign-ins move, unii's tasks give
    # way to ki's (made now, started below, once ki.exe is in place)
    # ki's tasks made from unii's, to start once ki.exe is in place: kept
    # in <data dir>\.renaming (a line "start <name>" each) with the rest of
    # the move's state, till all is done, so a run stopped halfway (a
    # failed write of the exe, a crash) starts them, and removes unii's
    # exe, when it runs again
    $fresh = @()
    if ($renaming) {
      $mark = Join-Path $cur '.renaming'
      if (Test-Path -LiteralPath $mark) {
        $fresh = @(Get-Content -LiteralPath $mark | Where-Object { $_ -match '^start ki-(serve|device)$' } | ForEach-Object { $_.Substring(6) } | Select-Object -Unique)
      } elseif ((Test-Path -LiteralPath $cur) -or ($olds.Count -gt 0)) {
        New-Item -ItemType Directory -Force -Path $cur | Out-Null
        New-Item -ItemType File -Path $mark | Out-Null
      }
      # unii's never start again once its data moves: a run again starts
      # the ki tasks made from them ($fresh)
      $stopped = @($stopped | Where-Object { @($olds | ForEach-Object { $_.TaskName }) -notcontains $_.TaskName })
      if ($moving) {
        Move-Item -LiteralPath $odir -Destination $dir
        Write-Host "  Moved $odir to $dir."
      }
      if ((Test-Path -LiteralPath $oconf) -and -not (Test-Path -LiteralPath $conf)) {
        Move-Item -LiteralPath $oconf -Destination $conf
        Write-Host "  Moved $oconf to $conf."
      }
      foreach ($t in $olds) {
        $part = $t.TaskName.Substring(5)
        $n = "ki-$part"
        if (-not (& $task $n)) {
          try {
            # its command line read as Windows reads it (unii.exe's path is
            # quoted only if it has a space), each part changed, and
            # written back quoted as Service.ts does; the XML by the XML
            # writer, so it is encoded as it should be
            $doc = [xml](Export-ScheduledTask -TaskName $t.TaskName -TaskPath '\' -ErrorAction Stop)
            $e = $doc.Task.Actions.Exec
            $parts = New-Object System.Collections.Generic.List[string]
            $given = $false
            foreach ($a in @(& $argv ([string]$e.Arguments))) {
              if (($a -match '(^|[\\/])unii\.exe$') -or ($a -ieq $oldBin)) { $a = $bin }
              elseif ($a -like '--env=UNII_DIR=*') { $a = '--env=KI_DIR=' + $dir; $given = $true }
              elseif ($a -match '^--env=UNII_([A-Za-z0-9_]*)=') {
                if (($reads + $own) -notcontains $Matches[1]) { continue }
                $a = '--env=KI_' + $a.Substring('--env=UNII_'.Length)
              }
              $parts.Add($a)
            }
            # unii's data moved from the default folder to one ki isn't
            # told of otherwise
            if (-not $given -and -not (& $samedir $dir (Join-Path $HOME '.ki'))) {
              $at = $parts.IndexOf('--service')
              if ($at -lt 0) { $at = $parts.Count - 1 }
              $parts.Insert($at + 1, '--env=KI_DIR=' + $dir)
            }
            $e.Arguments = (@($parts | ForEach-Object { & $winq $_ }) -join ' ')
            $doc.Task.RegistrationInfo.Description = 'ki-made: `ki ' + $part + ' -d` made this task, and makes it again; `ki ' + $part + ' stop` removes it.'
            Register-ScheduledTask -TaskName $n -TaskPath '\' -Xml $doc.OuterXml -ErrorAction Stop | Out-Null
          } catch {
            Write-Host ("  Could not make the task $n from " + $t.TaskName + " (" + $_.Exception.Message + "), so " + $t.TaskName + " stays as it was (stopped): run this again" + $(if ([string]$t.Principal.RunLevel -eq 'Highest') { ' as administrator' } else { '' }) + " to move it.")
            continue
          }
        }
        $k = & $task $n
        if ($k -and ([string]$k.Description -match 'ki-made') -and ($fresh -notcontains $n)) {
          $fresh += $n
          Add-Content -LiteralPath (Join-Path $dir '.renaming') -Value "start $n"
        }
        try {
          Unregister-ScheduledTask -TaskName $t.TaskName -TaskPath '\' -Confirm:$false -ErrorAction Stop
          Write-Host ("  Removed unii's task " + $t.TaskName + ".")
        } catch {
          Write-Host ("  Could not remove unii's task " + $t.TaskName + " (" + $_.Exception.Message + "): remove it in an elevated shell: schtasks /delete /tn " + $t.TaskName + " /f")
        }
      }
      & $named
      $cur = $dir
    }

    # the agent team's own: the main agent's memory, copied once from chat,
    # and the fixed prompts, written every time
    $chat = Join-Path $dir 'chat'
    $main = Join-Path $dir 'agents\unii'
    if ((Test-Path -LiteralPath $chat) -and -not (Test-Path -LiteralPath $main)) {
      $copy = Join-Path $dir 'agents\.unii-copy'
      New-Item -ItemType Directory -Force -Path (Join-Path $dir 'agents') | Out-Null
      Remove-Item -LiteralPath $copy -Recurse -Force -ErrorAction SilentlyContinue
      if (-not (Test-Path -LiteralPath (Join-Path $dir '.renaming'))) { New-Item -ItemType File -Path (Join-Path $dir '.renaming') | Out-Null }
      Copy-Item -LiteralPath $chat -Destination $copy -Recurse
      Move-Item -LiteralPath $copy -Destination $main
      & $named
      Write-Host "  Copied $chat to $main, the main agent's memory in the agent team ($chat stays as it was)."
    }
    # every time: older data to this version's layout, each step once
    if (Test-Path -LiteralPath $dir -PathType Container) {
      $env:BUN_BE_BUN = '1'
      try { & $exe $upgrade $dir } finally { Remove-Item Env:\BUN_BE_BUN -ErrorAction SilentlyContinue }
      if ($LASTEXITCODE -ne 0) { throw "bringing your data in $dir to ki $Ver's layout stopped halfway (see above): run this again. ki $Ver was not installed." }
    }
    Remove-Item -LiteralPath (Join-Path $env:LOCALAPPDATA 'unii') -Recurse -Force -ErrorAction SilentlyContinue
    $share = Join-Path $env:LOCALAPPDATA 'ki'
    New-Item -ItemType Directory -Force -Path $share | Out-Null
@PROMPT_FILES_PS1@

    # beside $bin first (temp may be another drive), then swapped in: the
    # old exe renamed (it may run: this may be its `ki update`), the old
    # ones that no longer run removed
    $folder = Split-Path -Parent $bin
    $new = "$bin.new"
    $finish = $(if ($renaming) { ": fix that, then run this again to finish moving unii over (its tasks start then)" } else { '' })
    try {
      New-Item -ItemType Directory -Force -Path $folder | Out-Null
      Copy-Item -LiteralPath $exe -Destination $new -Force
    } catch {
      throw "could not write $bin ($($_.Exception.Message))$finish"
    }
    $old = $null
    if (Test-Path -LiteralPath $bin) {
      $olds2 = '^' + [regex]::Escape($leaf) + '\.old(-[0-9]+)?$'
      Get-ChildItem -LiteralPath $folder -File | Where-Object { $_.Name -match $olds2 } | ForEach-Object { Remove-Item -LiteralPath $_.FullName -Force -ErrorAction SilentlyContinue }
      $old = "$bin.old"
      for ($k = 2; Test-Path -LiteralPath $old; $k++) { $old = "$bin.old-$k" }
      Move-Item -LiteralPath $bin -Destination $old
    }
    try {
      Move-Item -LiteralPath $new -Destination $bin
    } catch {
      if ($old) { Move-Item -LiteralPath $old -Destination $bin }
      Remove-Item -LiteralPath $new -Force -ErrorAction SilentlyContinue
      throw "could not write $bin ($($_.Exception.Message))$finish"
    }
    # the version check's cache, from before unii 18 (it checks no more)
    Remove-Item -LiteralPath (Join-Path $conf 'check.json'), (Join-Path $dir 'check.json') -Force -ErrorAction SilentlyContinue

    Write-Host ""
    Write-Host ("  ki $Ver" + $(if ($Ver -match '\.rc') { ' (release candidate)' } else { '' }) + " is installed at $bin.")
    Write-Host "  Server: ki serve -d   Device: ki device -d <url>"
    # the user PATH, as written (REG_EXPAND_SZ, %VARS% kept), then a
    # setting's change told to Windows, so new terminals find ki: unless
    # the saved user or machine Path has the folder (this shell's own
    # $env:Path may have it only for now); this shell's gets it too.
    # unii's folder (the default one) leaves it.
    $key = [Microsoft.Win32.Registry]::CurrentUser.OpenSubKey('Environment', $true)
    $path = [string]$key.GetValue('Path', '', 'DoNotExpandEnvironmentNames')
    $have = @($path -split ';' | Where-Object { $_ -ne '' })
    $machine = @(([string][Environment]::GetEnvironmentVariable('Path', 'Machine')) -split ';' | Where-Object { $_ -ne '' })
    $same = { param($p, $f) [Environment]::ExpandEnvironmentVariables($p).TrimEnd('\') -ieq $f.TrimEnd('\') }
    $oldFolder = Split-Path -Parent $oldBin
    $gone = $renaming -and ((Split-Path -Leaf $oldBin) -ieq 'unii.exe') -and -not ($oldFolder -ieq $folder)
    $keep = @($have | Where-Object { -not ($gone -and (& $same $_ $oldFolder)) })
    $there = @($keep + $machine | Where-Object { & $same $_ $folder })
    if ($there.Count -eq 0) { $keep += $folder }
    if (($keep -join ';') -ne ($have -join ';')) {
      $key.SetValue('Path', ($keep -join ';'), [Microsoft.Win32.RegistryValueKind]::ExpandString)
      [Environment]::SetEnvironmentVariable('KI_PATH_SET', '1', 'User')
      [Environment]::SetEnvironmentVariable('KI_PATH_SET', [NullString]::Value, 'User')
      if ($there.Count -eq 0) { Write-Host "  Added $folder to your PATH: open a new terminal to run ki by name." }
    }
    $key.Close()
    if (@($env:Path -split ';' | Where-Object { $_ -ne '' -and (& $same $_ $folder) }).Count -eq 0) {
      $env:Path = "$env:Path;$folder"
    }
    # unii's exe: removed now, or (while the `unii update` that ran this
    # still runs it) once that has quit, with its folder if it was the
    # default one and holds nothing else of ours
    if ($renaming -and (Test-Path -LiteralPath $oldBin -PathType Leaf) -and -not ($oldBin -ieq $bin)) {
      try {
        Remove-Item -LiteralPath $oldBin -Force
        Write-Host "  Removed unii's exe $oldBin."
      } catch {
        $wait = [int]("0" + $env:UNII_UPDATER)
        $later = "try { Wait-Process -Id $wait -Timeout 600 -ErrorAction SilentlyContinue } catch {}; Remove-Item -LiteralPath '" + $oldBin.Replace("'", "''") + "' -Force -ErrorAction SilentlyContinue"
        Start-Process -WindowStyle Hidden -FilePath 'powershell.exe' -ArgumentList @('-NoProfile', '-Command', $later) | Out-Null
        Write-Host "  unii's exe $oldBin is removed once it quits."
      }
      if ($gone) {
        Get-ChildItem -LiteralPath $oldFolder -File -ErrorAction SilentlyContinue | Where-Object { $_.Name -match '^unii\.exe\.(old(-[0-9]+)?|new)$' } | ForEach-Object { Remove-Item -LiteralPath $_.FullName -Force -ErrorAction SilentlyContinue }
        Remove-Item -LiteralPath $oldFolder -ErrorAction SilentlyContinue
      }
    }
    $global:LASTEXITCODE = 0
    # last: ki's tasks that run, restarted on the new exe by Task
    # Scheduler (run from such a service's shell, `ki update`, this ends
    # with it: so that one goes last, else the device, whose shells run
    # such updates)
    $made = @()
    try { $made = @('serve', 'device' | ForEach-Object { & $task "ki-$_" } | Where-Object { $_ -and ([string]$_.Description -match 'ki-made') -and ([string]$_.State -eq 'Running') }) } catch {}
    $made = @($made | Sort-Object { $mine -match ('\s"?' + $_.TaskName.Substring(3) + '"?\s') }, { $_.TaskName -eq 'ki-device' })
    # each runs $bin (the one this run wrote: a run before may have
    # failed writing another), and ki's that run already are left
    $fresh = @($fresh | Where-Object { $k = & $task $_; $k -and ([string]$k.State -ne 'Running') -and (@($made | ForEach-Object { $_.TaskName }) -notcontains $_) })
    foreach ($n in $fresh) {
      try {
        $doc = [xml](Export-ScheduledTask -TaskName $n -TaskPath '\' -ErrorAction Stop)
        $e = $doc.Task.Actions.Exec
        $parts = @(& $argv ([string]$e.Arguments))
        $at = [array]::IndexOf(@($parts | ForEach-Object { $_ -match '(^|[\\/])ki\.exe$' }), $true)
        if ($at -ge 0 -and -not ($parts[$at] -ieq $bin)) {
          $parts[$at] = $bin
          $e.Arguments = (@($parts | ForEach-Object { & $winq $_ }) -join ' ')
          Register-ScheduledTask -TaskName $n -TaskPath '\' -Xml $doc.OuterXml -Force -ErrorAction Stop | Out-Null
        }
      } catch {}
    }
    $stopped = @()
    foreach ($n in @($fresh) + @($halted | ForEach-Object { $_.TaskName })) {
      Write-Host ("  Starting $n, on ki $Ver.")
      try { Start-ScheduledTask -TaskName $n -TaskPath '\' -ErrorAction Stop } catch { Write-Host ("  Could not start ${n}: run ki " + $n.Substring(3) + " -d to.") }
    }
    # the move is done
    Remove-Item -LiteralPath (Join-Path $dir '.renaming') -Force -ErrorAction SilentlyContinue
    foreach ($t in $made) {
      Write-Host ("  Restarting " + $t.TaskName + " on ki $Ver.")
      try { Start-ScheduledTask -TaskName $t.TaskName -TaskPath '\' -ErrorAction Stop } catch { Write-Host ("  Could not restart " + $t.TaskName + ": run " + $(if ([string]$t.Principal.RunLevel -eq 'Highest') { 'sudo ' } else { '' }) + "ki " + $t.TaskName.Substring(3) + " -d to.") }
    }
  } catch {
    Write-Host ("ki: " + $_.Exception.Message) -ForegroundColor Red
    foreach ($t in $stopped) {
      try {
        Start-ScheduledTask -TaskName $t.TaskName -TaskPath '\' -ErrorAction Stop
        Write-Host ("  Started " + $t.TaskName + " again.")
      } catch {
        Write-Host ("  Could not start " + $t.TaskName + " again (" + $_.Exception.Message + "): start it with schtasks /run /tn " + $t.TaskName + $(if ([string]$t.Principal.RunLevel -eq 'Highest') { ' (as administrator)' } else { '' }) + ".")
      }
    }
    $global:LASTEXITCODE = 1
  } finally {
    if ($tmp) { Remove-Item -LiteralPath $tmp -Recurse -Force -ErrorAction SilentlyContinue }
  }
}
